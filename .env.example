# JobHunter environment template.
# Copy to `.env` for local development:  cp .env.example .env
# Real environment variables always override values in this file.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# development | production | testing
FLASK_CONFIG=development

# Required in production. The app refuses to start with the development default.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use a local SQLite file (zero setup).
# Set it to a PostgreSQL URL for production. Neon / Supabase / RDS all work —
# `postgres://` and Neon's `channel_binding` parameter are normalised for you.
#
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Connection pool tuning. pool_pre_ping is always on; these control the pool size.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=280
# DB_CONNECT_TIMEOUT=10

# Escape hatch: allow SQLite even when FLASK_CONFIG=production.
# ALLOW_SQLITE_IN_PRODUCTION=1

# ---------------------------------------------------------------------------
# Deployment behind a proxy
# ---------------------------------------------------------------------------
# Number of trusted upstream proxies (Nginx / PaaS router). Set to 1 when the
# app is served through the bundled Nginx or a platform load balancer so that
# X-Forwarded-Proto/Host are honoured and redirects stay on https.
# TRUSTED_PROXIES=1

# Only enable once every client reaches the app over HTTPS — it is a
# browser-level commitment that is painful to undo.
# ENABLE_HSTS=0

# ---------------------------------------------------------------------------
# Abuse protection
# ---------------------------------------------------------------------------
# Max failed logins / register / reset-request attempts per client per window.
# Set to 0 to disable.
# LOGIN_RATE_LIMIT=8
# LOGIN_RATE_WINDOW=300

# The public JSON API has its own budget, keyed per endpoint, because
# POST /api/match re-vectorizes the active job corpus on every call.
# API_RATE_LIMIT=30
# API_RATE_WINDOW=60

# Minimum accepted password length on registration and password reset.
# MIN_PASSWORD_LENGTH=8

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Outbound email is recorded in the application log rather than sent. There is
# a single transport seam to change: app/services/mail.py::_send.
MAIL_DEFAULT_SENDER=alerts@jobhunter.local

# ---------------------------------------------------------------------------
# Async worker (optional — only used by docker-compose worker/beat services)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Shared AI gateway (OpenAI-compatible) — OPTIONAL, OFF BY DEFAULT
# ---------------------------------------------------------------------------
# Job ranking is TF-IDF + cosine similarity and needs no network call at all.
# These settings only power the optional written rationale on the job detail
# page, which stays off until AI_EXPLAIN_MATCHES=1 *and* a base URL + key are
# both present. With the values below empty the app runs fully offline.
#
# Point these at your own OpenAI-compatible endpoint. No third-party host is
# baked into the source, and no credential is ever committed.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_TIMEOUT_SECONDS=60
# AI_MAX_RETRIES=2

# Model name per feature, as your gateway exposes it. The per-feature override
# wins, then AI_MODEL_CHAT, then AI_MODEL_DEFAULT. There is no built-in default
# model name, because only your gateway knows which models it serves.
# AI_MODEL_DEFAULT=
# AI_MODEL_CHAT=
# AI_MODEL_ANALYZE=
# AI_MODEL_GENERATE=
# AI_MODEL_SUMMARIZE=

# Opt-in. Leave 0 to keep ranking exactly as it is today (no network calls).
# AI_EXPLAIN_MATCHES=0
