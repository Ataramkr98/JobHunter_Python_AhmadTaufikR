{
  "name": "jobhunter-frontend",
  "private": true,
  "description": "Frontend build for JobHunter: compiles Tailwind CSS and generates a minimal Lucide icon sprite from the templates.",
  "scripts": {
    "build:css": "tailwindcss -i ./app/static/css/input.css -o ./app/static/css/app.css --minify",
    "build:sprite": "python scripts/build_icon_sprite.py",
    "build:check": "npm run build:sprite -- --check",
    "build": "npm run build:css && npm run build:sprite",
    "screenshots": "node scripts/capture_screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-static": "^1.33.0",
    "playwright": "^1.63.0",
    "tailwindcss": "3.4.17"
  }
}
